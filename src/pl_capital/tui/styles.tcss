Screen {
    background: $background;
    color: $foreground;
}
#banner {
    height: 2;
    content-align: left middle;
    padding: 0 2;
    background: $panel;
    color: $foreground;
    text-style: bold;
    border-bottom: solid $border-blurred;
}
#workspace { height: 1fr; }
#sidebar {
    width: 22;
    padding: 0 1;
    background: $panel;
    border-right: solid $border-blurred;
}
#sidebar Static, #inspector Static { height: auto; margin-bottom: 1; }
.section-title { color: $text-primary; text-style: bold; margin-top: 1; }
.muted { color: $text-muted; }
#main { width: 1fr; padding: 0 1; }
#timeline { height: 1fr; scrollbar-size: 1 1; }
#welcome { margin: 1; padding: 1; color: $foreground; }
.user-card {
    height: auto;
    margin: 1 0 0 2;
    padding: 0 1;
    background: $panel;
    color: $foreground;
}
.answer-card {
    height: auto;
    margin: 1 0;
    padding: 1;
    background: $surface;
    color: $foreground;
    border: none;
}
.answer-headline { height: auto; text-style: bold; color: $foreground; background: $surface; }
.answer-status { height: 1; color: $text-muted; }
.answer-next-step { height: auto; color: $text-primary; margin-top: 1; }
.answer-body { height: auto; margin: 0; padding: 0; color: $foreground; }
.explanation-title { height: 1; text-style: bold; color: $text-secondary; margin-top: 1; }
.explanation-step { height: auto; color: $foreground; }
.provenance { height: auto; color: $text-muted; margin-top: 1; }
.answer-warning { height: auto; color: $text-warning; margin-top: 1; }
.notice { height: auto; margin: 1; padding: 1; background: $panel; color: $foreground; }
#composer {
    height: 3;
    min-height: 3;
    max-height: 7;
    border: round $border-blurred;
    background: $surface;
    color: $foreground;
    padding: 0 1;
}
#composer:focus { border: round $primary; }
#composer-hint { height: 1; padding: 0 1; color: $text-muted; }
#loading { height: 1; color: $text-primary; }
#inspector {
    width: 26;
    padding: 0 1;
    background: $panel;
    border-left: solid $border-blurred;
}
#model-status { color: $foreground; }
#status { height: 1; padding: 0 1; background: $panel; color: $foreground; }
Footer { background: $panel; }
.execution-trace { height: auto; margin-top: 1; background: $panel; color: $foreground; border: none; padding: 0; }
.evidence-section, .raw-diagnostics { height: auto; border: none; padding: 0; background: $panel; color: $foreground; }
Collapsible > Contents { padding: 0 1; }
.trace-detail, .code-view { height: auto; margin-bottom: 1; background: $panel; color: $foreground; }
.copy-sql { margin: 1 0; min-width: 12; width: auto; max-width: 100%; }
.result-table { width: 100%; min-height: 3; background: $surface; color: $foreground; scrollbar-size: 1 1; margin-top: 1; }
.result-table:focus { border: solid $primary; }
.result-table > .datatable--header, .result-table > .datatable--fixed { background: $panel; color: $foreground; text-style: bold; }
.result-table > .datatable--odd-row { background: $surface; color: $foreground; }
.result-table > .datatable--even-row { background: $panel; color: $foreground; }
.table-instructions { height: auto; color: $text-muted; }
.full-table { height: 3; min-width: 12; margin-top: 1; }
.column-legend { height: auto; border: none; padding: 0; background: $surface; }
.column-legend Static { height: auto; }
FullTableScreen, RecordDetailScreen { align: center middle; background: $background 85%; }
.table-dialog { width: 96%; height: 90%; padding: 1; background: $surface; border: round $primary; }
.table-dialog > Collapsible { height: auto; max-height: 8; }
.table-dialog > .close-table { height: 3; margin-top: 1; }
.record-fields { height: 1fr; }
.record-field { height: auto; margin-bottom: 1; }
.exposure-card { height: auto; margin: 0; padding: 0; background: $surface; color: $foreground; }
.exposure-totals { height: auto; color: $text-muted; }
.answer-actions { height: 3; margin-top: 1; }
.answer-actions Button { width: auto; min-width: 12; margin-right: 1; height: 3; }
.save-sql { display: none; }
.action-feedback { display: none; height: auto; color: $text-primary; margin-top: 1; }
.sql-unavailable { height: auto; color: $text-muted; }
ThemeChooser { align: center middle; background: $background 70%; }
#theme-dialog { width: 52; max-width: 94%; height: auto; padding: 1 2; background: $surface; color: $foreground; border: round $primary; }
#theme-dialog Static { height: auto; margin-bottom: 1; }
.dialog-title { text-style: bold; }
.theme-options { height: 3; margin-bottom: 1; }
.theme-options Button { width: 1fr; min-width: 8; margin-right: 1; }
