# Active provider: gemini or groq. Model flags also select the matching provider.
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-pro
GEMINI_API_KEY=replace-with-your-private-key
# Optional Groq compatibility:
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
GRAPH_BACKEND=auto
# Optional: PL_CAPITAL_DATA_DIR=/absolute/path/to/assessment
# Optional: PL_CAPITAL_CACHE_DIR=/private/user/cache
# Optional: PL_CAPITAL_CONFIG_DIR=/private/user/config
